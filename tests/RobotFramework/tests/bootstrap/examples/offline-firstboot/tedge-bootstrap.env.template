# /boot/firstboot/tedge-bootstrap.env - written per device at flash time,
# mode 600, shredded by the completion unit after success.
#
# The device identity (TEDGE_DEVICE_ID is the config override for device.id)
TEDGE_DEVICE_ID=SN-004211
# The one-time password this device was pre-registered with
# (fleet tooling, e.g. go-c8y-cli, registers the id/password pairs upfront)
DEVICE_ONE_TIME_PASSWORD=<pre-staged secret>
